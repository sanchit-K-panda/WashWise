# ==============================================================================
# WashWise Environment Variables
# ==============================================================================

# Supabase API Credentials
EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# College Email Domain (set to * to allow all email domains, or e.g. college.edu)
EXPO_PUBLIC_COLLEGE_EMAIL_DOMAIN=*

# Build & Runtime Variant (development | preview | production)
EXPO_PUBLIC_APP_VARIANT=development
